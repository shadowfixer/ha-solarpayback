# HA SunBack — Add to your configuration.yaml (typically in /config/configuration.yaml)
# This exposes a shell_command service that the app can call via POST /api/services/shell_command/ha_sunback_store
# The service receives the JSON payload as 'data' variable, which we pass to the script.

shell_command:
  # Writes grid events + tariff history to /config/ha-sunback-data.json (atomic, backed up by HA)
  # Called by the app with JSON body: {"gridEvents": [...], "tariffHistory": [...]}
  ha_sunback_store: 'python3 /config/packages/ha_sunback_store.py "{{ data | tojson }}"'

# After adding this, restart HA (or reload shell_commands via Developer Tools → YAML → Reload Shell Commands).
# The service will be available at: POST /api/services/shell_command/ha_sunback_store
# with JSON body: {"gridEvents": [...], "tariffHistory": [...]}